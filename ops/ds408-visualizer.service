# service host 上的系统级 unit。由 ops/deploy.sh 安装到
# /etc/systemd/system/ds408-visualizer.service
[Unit]
Description=DS408 Visualizer (408 data-structure visualizer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ds408
Group=ds408
WorkingDirectory=/opt/ds408-visualizer/app
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -c "import app; app.main(host='0.0.0.0', port=18511)"
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/ds408-visualizer

[Install]
WantedBy=multi-user.target
